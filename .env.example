# Copy to .env and adjust. .env is gitignored – never commit real credentials.
POSTGRES_USER=emg
POSTGRES_PASSWORD=change_me
POSTGRES_DB=electricity
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Analysis period (inclusive), local German time
START_DATE=2023-01-01
END_DATE=2025-12-31

LOG_LEVEL=INFO

# --- Analytics agent (Week 2) ---------------------------------------------------
# Read-only role the agent uses (created by `make agent-role`; must differ from POSTGRES_USER).
AGENT_DB_USER=emg_agent_ro
AGENT_DB_PASSWORD=change_me_too
AGENT_MAX_ROWS=500
AGENT_STATEMENT_TIMEOUT_MS=5000
# Groq: key from https://console.groq.com/keys ; model id from `python -m analytics_agent.cli --models`
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TIMEOUT_S=30
# Reasoning models (gpt-oss) use hidden reasoning tokens from this budget; keep it generous.
GROQ_MAX_TOKENS=4096
# Optional, only for models that support it: low | medium | high
GROQ_REASONING_EFFORT=
