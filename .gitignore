# Secrets
.env

# Data (raw files are large and subject to SMARD terms; processed files are reproducible)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.venv-dbt/
venv/
.coverage
coverage.xml
junit*.xml
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Power BI (binary report files can be large; keep the spec + DAX in git instead)
*.pbix
*.pbit

# OS / editors
.DS_Store
.vscode/
.idea/

# Logs
*.log
logs/

# dbt (profiles.yml is created from profiles.example.yml; credentials come from env vars)
dbt_electricity/target/
dbt_electricity/dbt_packages/
dbt_electricity/logs/
dbt_electricity/profiles.yml
dbt_electricity/.user.yml
